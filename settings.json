{
  "lastChangelogVersion": "0.87.1",
  "theme": "dark",
  "packages": [
    "npm:pi-provider-litellm",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:@vndv/pi-codegraph",
    "npm:@amaster.ai/pi-memory-mem0"
  ],
  "defaultModel": "gpt-6-luna",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "subagents": {
    "projectRootResolution": "git-root",
    "defaultModel": "gpt-6-luna",
    "defaultProvider": "litellm",
    "agentOverrides": {
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "oracle": {
        "model": "gpt-6-astra"
      },
      "delegate": {
        "model": "bedrock-claude-sonnet-5-5"
      },
      "researcher": {
        "model": "bedrock-claude-opus-5-5"
      },
      "worker": {
        "model": "gpt-6-luna"
      },
      "scout": {
        "model": "gpt-6-luna"
      },
      "reviewer": {
        "model": "gpt-6-astra""skills": [
          "go-reviewer"
        ]
      }
    }
  },
  "pi-memory-mem0": {
    "mode": "self-hosted",
    "baseUrl": "http://192.168.0.160:18000",
    "userId": "default-user",
    "userIdScope": "userIdScope"
  }
}
