{
  "lastChangelogVersion": "1.1.0",
  "theme": "dark",
  "packages": [
    "npm:pi-provider-litellm",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:@vndv/pi-codegraph",
    "npm:@amaster.ai/pi-memory-mem0",
    "npm:pi-ketch"
  ],
  "defaultModel": "bedrock-claude-sonnet-5-5",
  "defaultProvider": "litellm",
  "defaultThinkingLevel": "high",
  "subagents": {
    "projectRootResolution": "git-root",
    "defaultModel": "bedrock-claude-sonnet-5-5",
    "defaultProvider": "litellm",
    "agentOverrides": {
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "oracle": {
        "model": "bedrock-claude-opus-5-5"
      },
      "worker": {
        "model": "bedrock-claude-haiku-4-5"
      },
      "scout": {
        "model": "bedrock-claude-haiku-4-5"
      },
      "reviewer": {
        "model": "bedrock-claude-opus-5-5",
        "skills": [
          "go-reviewer"
        ]
      }
    }
  },
  "pi-memory-mem0": {
    "mode": "self-hosted",
    "baseUrl": "http://localhost:8000",
    "userId": "default-user",
    "userIdScope": "userIdScope"
  }
}
