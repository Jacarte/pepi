{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "disabled": true
    },
    "browsermcp": {
      "command": "npx",
      "args": [
        "@browsermcp/mcp@0.1.3"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.68"
      ]
    },
    "speaker": {
      "command": "/Users/javcab/Documents/maelstrom/voice-devtools/tts2mic-mcp",
      "env": {
        "TTS_CACHE_DIR": ".tts2mic-cache",
        "TTS_PROVIDER_NAME": "elevenlabs",
        "TTS_PROVIDER": "elevenlabs",
        "TTS_LANG": "en-US",
        "ELEVENLABS_VOICE_ID": "CwhRBWXzGAHq8TQ4Fs17",
        "ELEVENLABS_API_KEY": "{env:ELEVENLABS_API_KEY}",
        "TTS2MIC_MACOS_DEBUG_AFPLAY": "1",
        "DEEPGRAM_API_KEY": "{env:DEEPGRAM_API_KEY}"
      }
    },
    "voice-devtools": {
      "command": "bash",
      "args": [
        "-lc",
        "cd /Users/javcab/Documents/maelstrom/voice-devtools && export TTS2MIC_BACKEND=pipewire TTS2MIC_PULSE_SINK=tts2mic_tx TTS2MIC_SESSION_ADAPTER=maelstrom-demo && exec ./bin/tts2mic-mcp"
      ]
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "neo4j": {
      "command": "neo4j-mcp",
      "args": [
        "--neo4j-uri",
        "bolt://localhost:7687",
        "--neo4j-username",
        "neo4j",
        "--neo4j-password",
        "{env:NEO4J_PASSWORD}",
        "--neo4j-database",
        "neo4j",
        "--neo4j-read-only",
        "true",
        "--neo4j-telemetry",
        "false"
      ]
    },
    "Chrome": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "disabled": true
    },
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    }
  }
}
