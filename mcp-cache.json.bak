estamp","type":"string"},"searchContext":{"description":"Information about how the search keywords matched this item","type":"object","properties":{"keywords":{"type":"string","description":"The search keywords that were used"},"hasNameMatch":{"type":"boolean","description":"Whether keywords matched in the item name"},"hasContentMatch":{"type":"boolean","description":"Whether keywords matched in item content (description, messages, etc.)"}},"required":["keywords","hasNameMatch","hasContentMatch"],"additionalProperties":false},"contentSnippet":{"description":"Highlighted snippet from item content (docs, dashboards, whiteboards, forms)","type":"string"},"descriptionSnippet":{"description":"Highlighted snippet from task description","type":"string"},"fileContentSnippet":{"description":"Highlighted snippet from attachment file content","type":"string"},"customFieldMatches":{"description":"Custom fields that matched the search query","type":"array","items":{"type":"object","properties":{"fieldName":{"type":"string","description":"Name of the custom field that matched"},"snippet":{"type":"string","description":"Highlighted snippet from the custom field value"}},"required":["fieldName","snippet"],"additionalProperties":false,"description":"Information about a custom field that matched the search query"}},"downloadUrl":{"type":"string","description":"Download URL for the attachment"},"uploadDate":{"description":"Upload timestamp","type":"string"}},"required":["id","type","name","url","downloadUrl"],"additionalProperties":false},{"type":"object","properties":{"id":{"type":"string","description":"Unique identifier for the item"},"type":{"type":"string","const":"whiteboard"},"name":{"type":"string","description":"Display name of the item"},"nameHighlight":{"description":"Highlighted portions of name matching search query","type":"array","items":{"type":"string"}},"url":{"type":"string","description":"Direct URL to access the item in ClickUp"},"hierarchy":{"description":"Hierar